# Database
DATABASE_URL=postgres://cis:cis_dev_password@localhost:5432/cis_dev
DATABASE_TEST_URL=postgres://cis:cis_test_password@localhost:5433/cis_test

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_64_random_bytes_hex

# API
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Rate limiting
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000

# AI report narrative — Microsoft (Azure AI) Foundry, OpenAI-compatible v1 route.
# AZURE_AI_ENDPOINT may be the resource URL or the project URL. Paste the resource
# key into AZURE_AI_API_KEY (Foundry portal → your resource → Keys and Endpoint).
AZURE_AI_ENDPOINT=https://dragnet-gateway-resource.services.ai.azure.com/api/projects/dragnet-gateway
AZURE_AI_API_KEY=
AZURE_AI_MODEL=DeepSeek-V4-Pro

# Release notices to firm coordinators. Unset SMTP_URL: notices are recorded in
# email_outbox (status "logged") but not sent.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="CIS × Dragnet <no-reply@cis.example>"
# Where coordinators sign in (the link in the notice); defaults to REPORT_RENDER_URL.
# PORTAL_URL=https://study.cis.example

# Demo seed only: copy the operators' password hashes from this database (your
# dev DB). Passwords are never stored in plaintext — set one with:
#   pnpm --filter @cis/api set-password <email>
# PASSWORD_SOURCE_DATABASE_URL=postgres://...
