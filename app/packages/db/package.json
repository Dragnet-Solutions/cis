{
  "name": "@cis/db",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/seed','dist/seed',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/",
    "migrate:up": "node-pg-migrate up --migrations-dir migrations --database-url-var DATABASE_URL",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --database-url-var DATABASE_URL",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations",
    "migrate:status": "node-pg-migrate status --migrations-dir migrations --database-url-var DATABASE_URL"
  },
  "dependencies": {
    "@cis/shared-types": "workspace:*",
    "@cis/survey": "workspace:*",
    "pg": "^8.12.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.6",
    "node-pg-migrate": "^7.7.0",
    "typescript": "*",
    "vitest": "*"
  }
}
