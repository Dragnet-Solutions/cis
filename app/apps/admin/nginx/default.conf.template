# Rendered at container start by the nginx image's envsubst step:
# ${API_UPSTREAM} is replaced; nginx's own $variables are left untouched.

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 5m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Content-Security-Policy for the SPA shell (index.html). The Vite build
    # emits no inline script or style, so neither needs 'unsafe-inline'; React
    # style props are set through the CSSOM, which style-src does not govern.
    # The only third-party origins are Google Fonts (the stylesheet and its font
    # files, linked from index.html). Downloads are blob: URLs opened by an
    # <a download> click, which CSP does not restrict. Sent only on the HTML
    # locations below: /api/ carries the API's own stricter policy.
    # (add_header in a location replaces this level's headers, so each HTML
    # location repeats it.) Not substituted by envsubst: there is no such env var.
    set $cis_csp "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Liveness for the container HEALTHCHECK / k8s probes.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API — the trailing slash on proxy_pass strips the /api prefix,
    # matching the Vite dev-server proxy.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;   # PDF rendering and AI narrative calls are slow
    }

    # Set-password links carry a single-use token in the URL: keep it out of
    # the access log (both the page and the API lookup).
    location /api/auth/password-set/ {
        access_log off;
        proxy_pass ${API_UPSTREAM}/auth/password-set/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /set-password {
        access_log off;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy $cis_csp always;
        try_files /index.html =404;
    }

    # Vite's content-hashed bundles never change — cache them hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # The CIS crest used by every email ({{logo_url}} = <origin>/cis-logo.png).
    # Mail clients and their image proxies fetch it cross-origin, so it is
    # cached for a week but not immutable: a new crest under the same name
    # reaches inboxes within days. 404 rather than the SPA shell if missing.
    location = /cis-logo.png {
        access_log off;
        expires 7d;
        add_header Cache-Control "public, max-age=604800" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Client-side routes (/firm, /survey, /print/*) fall back to the SPA shell,
    # which must never be cached so new releases are picked up.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy $cis_csp always;
        try_files $uri $uri/ /index.html;
    }
}
